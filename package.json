{
  "name": "@holepunchto/hyperdiscovery",
  "version": "1.3.0",
  "description": "Peer discovery powered by HyperDHT",
  "main": "index.js",
  "dependencies": {
    "b4a": "^1.6.7",
    "compact-encoding": "^3.0.0",
    "hypercore-crypto": "^3.6.0",
    "hyperdb": "^6.6.3",
    "hyperdht": "^6.20.5",
    "hyperschema": "^1.12.1",
    "protomux": "^3.10.1",
    "ready-resource": "^1.1.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/holepunchto/hyperdiscovery.git"
  },
  "scripts": {
    "lint": "prettier --check . && lunte",
    "format": "prettier --write . && lunte --fix",
    "test": "brittle-node -c test.js",
    "test:bare": "brittle-bare -c test.js"
  },
  "author": "Holepunch Inc.",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/holepunchto/hyperdiscovery/issues"
  },
  "homepage": "https://github.com/holepunchto/hyperdiscovery",
  "devDependencies": {
    "bare-fs": "^4.7.4",
    "bare-http1": "^4.5.7",
    "bare-https": "^3.0.0",
    "bare-process": "^4.5.1",
    "bare-url": "^2.4.6",
    "bare-utils": "^1.6.0",
    "bare-v8": "^1.0.1",
    "bare-zlib": "^1.4.1",
    "brittle": "^4.1.0",
    "lunte": "^1.8.4",
    "prettier-config-holepunch": "^2.0.0",
    "prom-client": "^15.1.3"
  },
  "imports": {
    "fs": {
      "bare": "bare-fs",
      "default": "fs"
    },
    "http": {
      "bare": "bare-http1",
      "default": "http"
    },
    "https": {
      "bare": "bare-https",
      "default": "https"
    },
    "process": {
      "bare": "bare-process",
      "default": "process"
    },
    "v8": {
      "bare": "bare-v8",
      "default": "v8"
    },
    "url": {
      "bare": "bare-url",
      "default": "url"
    },
    "util": {
      "bare": "bare-utils",
      "default": "util"
    },
    "zlib": {
      "bare": "bare-zlib",
      "default": "zlib"
    }
  }
}
